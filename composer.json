{
  "name": "glushkovds/simflex-template",
  "description": "Simflex CMS",
  "keywords": [
    "php",
    "simplex-admin",
    "simplex-cms",
    "simflex"
  ],
  "homepage": "https://github.com/glushkovds/simflex-template",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Denis Glushkov",
      "email": "amkarovec@gmail.com",
      "homepage": "https://github.com/glushkovds"
    },
    {
      "name": "pf",
      "homepage": "https://rpgclub.me"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "ext-gd": "*",
    "glushkovds/simflex": "*",
    "vlucas/phpdotenv": "^5.4",
    "scssphp/scssphp": "^1.11",
    "tubalmartin/cssmin": "^4.1",
    "ext-readline": "*",
    "growtask/simflex-file-manager": "dev-master",
    "codeception/module-phpbrowser": "*",
    "codeception/module-asserts": "*",
    "maximebf/debugbar": "^1.22",
    "filp/whoops": "^2.15",
    "hflabs/dadata": "^24.4",
    "ext-simplexml": "*",
    "simflex/user": "*",
    "simflex/ecom": "*",
    "simflex/catalog": "*",
    "phpmailer/phpmailer": "^6.9",
    "amocrm/amocrm-api-library": "^1.14",
    "phpoffice/phpspreadsheet": "1.29.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": ""
    }
  },
  "repositories": [
    {
      "url": "https://github.com/glushkovds/simflex.git",
      "type": "git"
    },
    {
      "url": "https://git.sn9.ru/simflex/ecom.git",
      "type": "git"
    },
    {
      "url": "https://git.sn9.ru/simflex/catalog.git",
      "type": "git"
    },
    {
      "url": "https://git.sn9.ru/simflex/user.git",
      "type": "git"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "codeception/module-webdriver": "^4.0"
  }
}
